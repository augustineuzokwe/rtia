# Required: your Google AI Studio API key for live agent calls.
# Get a key at https://aistudio.google.com/app/apikey
# Copy this file to `.env` and replace the placeholder.
# All four production agents + the eval-suite judge run on Gemini 3.5
# Flash (paid tier - see ADR-0006 + ADR-0007 for the provider history).
GOOGLE_API_KEY=your-google-ai-studio-key-here

# Optional: switch the LLM provider to fully local Ollama for $0 API spend.
# Default (unset or "gemini") uses the Google key above. Set "ollama" to
# route every agent through a local Llama 3.1 8B model - requires Ollama
# installed and `ollama pull llama3.1:8b`. See docs/USAGE.md §10.
# RTIA_LLM_PROVIDER=gemini

# Optional: also route the eval-suite judge through Ollama for a true $0
# end-to-end stack. Independent of RTIA_LLM_PROVIDER so you can keep the
# judge on Gemini for apples-to-apples generator comparison.
# RTIA_OLLAMA_JUDGE=0

# Optional: LangSmith observability.
# Get a key at https://smith.langchain.com (Settings → API Keys).
# When LANGSMITH_TRACING=true AND LANGSMITH_API_KEY is set, every LLM call
# in the pipeline is auto-traced under LANGSMITH_PROJECT. Leave unset to
# disable tracing entirely - the pipeline runs identically without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rtia

# Phase 12.4 - environment mode for the production tracing guard.
# Allowed values: development (default when unset), ci, production.
# When RTIA_ENV=production AND LANGSMITH_TRACING=true, the demo and any
# entry point calling assert_safe_for_env() refuse to start. See
# docs/adr-0008-pii-langsmith.md for the policy decision.
RTIA_ENV=development

# Phase 14 - API + UI surface.
# Optional: pin a stable bearer token across `uv run python scripts/run_api.py`
# restarts. When unset, the server mints a fresh URL-safe token on every
# startup and prints it in the banner. Useful when iterating locally with
# a hot browser tab open at http://127.0.0.1:8000/?token=…
# RTIA_API_TOKEN=
# RTIA_API_HOST=127.0.0.1
# RTIA_API_PORT=8000

# Phase 15.2 - backlog exporters.
# Jira Cloud - generate an API token at https://id.atlassian.com/manage-profile/security/api-tokens
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_EMAIL=you@example.com
# JIRA_API_TOKEN=ATATT...
#
# GitHub - fine-grained PAT with "Issues: Read & write" scope; if you also
# want to push to a Project (v2), grant "Projects: Read & write" too.
# GITHUB_TOKEN=ghp_...

# Required: your Anthropic API key for live agent calls.
# Get one at https://console.anthropic.com/
# Copy this file to `.env` and replace the placeholder.
ANTHROPIC_API_KEY=your-anthropic-key-here

# Optional: LangSmith observability.
# Get a key at https://smith.langchain.com (Settings → API Keys).
# When LANGSMITH_TRACING=true AND LANGSMITH_API_KEY is set, every LLM call
# in the pipeline is auto-traced under LANGSMITH_PROJECT. Leave unset to
# disable tracing entirely — the pipeline runs identically without it.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=rtia
